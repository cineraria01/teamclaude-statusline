+      // [local patch: reload-endpoint] Re-read the config from disk and apply
+      // account changes (enable/disable/priority/new accounts/credentials) to the
+      // running server, then force a fleet-wide quota re-measure — the same work
+      // as the TUI "R" key, but reachable via `teamclaude reload` against a
+      // headless server. Localhost is auth-exempt above, same as /status; remote
+      // callers still need the proxy API key.
+      if (req.method === 'POST' && req.url === '/teamclaude/reload') {
+        if (!hooks.reload) {
+          res.writeHead(501, { 'Content-Type': 'application/json' });
+          res.end(JSON.stringify({ error: 'reload hook not wired' }));
+          return;
+        }
+        try {
+          const result = await hooks.reload();
+          res.writeHead(200, { 'Content-Type': 'application/json' });
+          res.end(JSON.stringify(result ?? {}));
+        } catch (err) {
+          res.writeHead(500, { 'Content-Type': 'application/json' });
+          res.end(JSON.stringify({ error: err?.message || String(err) }));
+        }
+        return;
+      }
