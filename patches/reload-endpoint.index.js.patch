 // ── enable / disable / priority ─────────────────────────────
+
+// [local patch: reload-endpoint] Apply disk-config changes to a running server
+// in place, via POST /teamclaude/reload. Returns true when a server handled it.
+async function requestServerReload(config) {
+  const running = await findRunningServer(config);
+  if (!running) return { state: 'not-running' };
+  let res;
+  try {
+    res = await fetch(`http://127.0.0.1:${running.port}/teamclaude/reload`, { method: 'POST' });
+  } catch (err) {
+    return { state: 'unreachable', detail: err.message };
+  }
+  if (res.status === 404) return { state: 'unsupported' }; // server predates the patch
+  if (!res.ok) return { state: 'failed', detail: `HTTP ${res.status}` };
+  const body = await res.json().catch(() => ({}));
+  return { state: 'ok', body };
+}
+
+async function reloadCommand() {
+  const config = await loadConfig();
+  if (!config) { console.error('No config found.'); process.exit(1); }
+  const r = await requestServerReload(config);
+  switch (r.state) {
+    case 'not-running':
+      console.log('No running server — nothing to reload (start one with: teamclaude server).');
+      return;
+    case 'unsupported':
+      console.error('The running server predates the reload endpoint — restart once: teamclaude restart');
+      process.exit(1);
+      break;
+    case 'unreachable':
+    case 'failed':
+      console.error(`Reload failed: ${r.detail}`);
+      process.exit(1);
+      break;
+    case 'ok': {
+      const added = r.body?.added || 0;
+      console.log(added > 0
+        ? `Reloaded config — picked up ${added} new account(s).`
+        : 'Reloaded config — enable/disable/priority/credential changes applied.');
+      if (r.body?.quotaProbed === -1 || r.body?.quotaProbed == null) {
+        console.log('  (quota re-measure skipped — no request has flowed through the proxy yet)');
+      }
+      return;
+    }
+  }
+}
 
